# Milestone 1 onward. Do not add real credentials to this file.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/electoral_compliance
# Connessione diretta, senza pool: usata solo dalle migration.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/electoral_compliance
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
DEV_BYPASS_AUTH=false
LOCAL_DEVELOPMENT_MODE=false

# Storage adapter configuration
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Provider adapters remain disabled until explicitly configured.
OCR_PROVIDER=mock
AI_PROVIDER=mock
EMAIL_PROVIDER=mock
MALWARE_SCAN_PROVIDER=mock
