            "offsetDefinition": "P3M"
          }
        },
        {
          "ruleCode": "IT-COM-REPORT-ZERO-001",
          "name": "Rendiconto dovuto anche in assenza di movimenti",
          "description": "Il rendiconto e' dovuto anche quando non risultano spese ne' contributi.",
          "category": "REPORTING",
          "severityDefault": "ACTION_REQUIRED",
          "legalSourceKey": "COREGE-TOSCANA-VADEMECUM",
