      "rules": [
        {
          "ruleCode": "IT-COM-SCOPE-002",
          "name": "Perimetro della rendicontazione comunale",
          "description": "Nei comuni oltre la soglia demografica si applica la disciplina di rendicontazione della campagna elettorale.",
          "category": "SCOPE",
          "severityDefault": "INFO",
          "legalSourceKey": "L96-2012-ART13",
          "conditionExpression": {
            "field": "demographics.population",
            "operator": "gt",
            "value": 15000
          },
          "effectType": "INFORMATION",
          "effectPayload": {
            "title": "Disciplina di rendicontazione applicabile",
            "description": "La campagna ricade nel perimetro della rendicontazione elettorale per i comuni sopra la soglia demografica. Verificare la fonte prima di attivare la regola."
          }
        },
        {
          "ruleCode": "IT-COM-MAND-001",
          "name": "Raccolta di fondi da terzi senza mandatario",
          "description": "Sono stati registrati contributi da soggetti diversi dal candidato in assenza di un mandatario elettorale.",
          "category": "MANDATARY",
          "severityDefault": "BLOCKER",
          "legalSourceKey": "L96-2012-ART13",
          "conditionExpression": {
            "all": [
              {
                "field": "demographics.population",
                "operator": "gt",
                "value": 15000
              },
              {
                "field": "finance.externalContributionCount",
                "operator": "gt",
                "value": 0
              },
              {
                "field": "mandatary.exists",
                "operator": "eq",
                "value": false
              }
            ]
          },
          "effectType": "BLOCKER",
          "effectPayload": {
            "title": "Contributi di terzi registrati senza mandatario elettorale",
            "description": "Risultano contributi provenienti da soggetti diversi dal candidato mentre non risulta nominato alcun mandatario elettorale. La posizione va verificata prima del deposito del rendiconto.",
            "severity": "BLOCKER"
          }
        },
        {
          "ruleCode": "IT-COM-MAND-002",
          "name": "Attivita' di verifica sulla nomina del mandatario",
          "description": "Attivita' operativa conseguente al rilievo sulla nomina del mandatario.",
          "category": "MANDATARY",
          "severityDefault": "ACTION_REQUIRED",
          "legalSourceKey": "L96-2012-ART13",
          "conditionExpression": {
            "all": [
              {
                "field": "finance.externalContributionCount",
                "operator": "gt",
                "value": 0
              },
              {
                "field": "mandatary.exists",
                "operator": "eq",
                "value": false
              }
            ]
          },
          "effectType": "TASK",
          "effectPayload": {
            "title": "Verificare la nomina del mandatario elettorale",
            "description": "Il regime dichiarato all'apertura della campagna potrebbe non essere piu' applicabile: verificare con il proprio consulente la necessita' di nominare un mandatario.",
            "priority": "CRITICAL"
          }
        },
        {
          "ruleCode": "IT-COM-LIMIT-MAYOR-001",
