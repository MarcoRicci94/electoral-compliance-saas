        {
          "ruleCode": "IT-SYS-ELECTION-SOURCE-001",
          "name": "Dati elettorali non verificati",
          "description": "Controllo di sistema: i dati demografici ed elettorali usati nei calcoli non risultano verificati su fonte ufficiale.",
          "category": "SYSTEM",
          "severityDefault": "WARNING",
          "legalSourceKey": "SYSTEM-CONTROL",
          "conditionExpression": {
