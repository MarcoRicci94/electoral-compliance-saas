          "effectType": "REQUIREMENT",
          "effectPayload": {
            "title": "Rendiconto dovuto anche senza spese ne' contributi",
            "description": "Non risulta registrato alcun movimento. Il rendiconto va comunque presentato: la campagna a zero non esonera dall'adempimento.",
            "severity": "ACTION_REQUIRED"
          }
        },
        {
          "ruleCode": "IT-COM-DOC-CORP-001",
          "name": "Documentazione dei contributi societari",
          "description": "I contributi provenienti da societa' richiedono una documentazione societaria e contabile specifica.",
          "category": "CONTRIBUTIONS",
          "severityDefault": "CRITICAL",
          "legalSourceKey": "COREGE-TOSCANA-VADEMECUM",
          "conditionExpression": {
